# Environment Configuration
# Copy this file to .env and fill with your actual credentials

# Exchange API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Trading Configuration
TRADING_PAIR=BTCUSDT
INITIAL_CAPITAL=10000.0
POSITION_SIZE_PERCENT=0.02
MAX_POSITIONS=3
USE_TESTNET=true

# Risk Management
STOP_LOSS_ATR_MULTIPLIER=1.5
TAKE_PROFIT_ATR_MULTIPLIER=2.5
TRAILING_STOP_ACTIVATION=0.015
TRAILING_STOP_DISTANCE=0.008
MAX_DAILY_LOSS_PERCENT=0.05

# Strategy Parameters
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
ATR_THRESHOLD_MULTIPLIER=1.2

# Execution
ORDER_RETRY_ATTEMPTS=3
ORDER_TIMEOUT_SECONDS=30
LATENCY_SIMULATION_MS=0

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/trading.log

# Backtest
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31
BACKTEST_DATA_PATH=./data/historical/
